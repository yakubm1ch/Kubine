# Kubine Environment Variables
#
# VITE_-prefixed variables are embedded in the browser bundle at build time.
# Never put service-role keys, secrets, or privileged credentials here.

# Database provider identifier (matches a supported provider in provider.catalog.js)
VITE_DATABASE_PROVIDER=supabase

# Supabase project URL (anon key scope only)
VITE_ENGINE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key (publishable, browser-safe)
VITE_ENGINE_SUPABASE_ANON_KEY=your-anon-key-here
